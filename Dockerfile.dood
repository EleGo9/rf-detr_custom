# Stessa base image di Yolo11 e Darknet per massima coerenza!
# 1. Catch the variable BEFORE the first FROM
ARG CU_VERSION=cu128

# 2. Map the variable to the correct base images
FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04 AS base-cu118
FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04 AS base-cu128

# 3. Dynamically resolve the actual base image
FROM base-${CU_VERSION}

ARG USER_UID=1000
ARG USER_GID=$USER_UID

# Evitiamo che apt-get si blocchi per chiedere il fuso orario
ENV DEBIAN_FRONTEND=noninteractive

# Installiamo Python 3, pip, sudo e le dipendenze OpenCV
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    sudo \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid $USER_GID vscode \
    && useradd --uid $USER_UID --gid $USER_GID -s /bin/bash -m -d /home/vscode vscode && \
    echo vscode:vscode | chpasswd && \
    usermod -aG sudo vscode && \
    echo '%sudo ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

USER vscode


WORKDIR /workspaces/rfdetr
COPY . .
RUN pip install --upgrade pip setuptools wheel
RUN pip install -e ".[train,onnx,visual]"

RUN pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    python-multipart \
    Pillow \
    easydict \
    PyYAML \
    requests

# Verifica rapida che l'installazione sia andata a buon fine
RUN python3 -c "import rfdetr; print(rfdetr.__file__)"

CMD ["/bin/bash"]